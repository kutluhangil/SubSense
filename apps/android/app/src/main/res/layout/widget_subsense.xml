<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Brand header: indigo accent dot + wordmark -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/widget_accent_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="SUBSENSE"
            android:textColor="#A5B4FC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_monthly_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monthly"
        android:textColor="#9CA3AF"
        android:textSize="11sp"
        android:letterSpacing="0.06"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/widget_monthly_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="$0.00"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <View
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#1FFFFFFF" />

    <TextView
        android:id="@+id/widget_next_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next"
        android:textColor="#9CA3AF"
        android:textSize="11sp"
        android:letterSpacing="0.06"
        android:textAllCaps="true" />

    <LinearLayout
        android:id="@+id/widget_next_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_next_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#A5B4FC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:maxLines="1" />

</LinearLayout>
