{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SubSense",
  "version": "3.0.0",
  "identifier": "com.subsense.apps",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SubSense",
        "width": 1240,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://open.er-api.com https://firebasestorage.googleapis.com ipc: http://ipc.localhost; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.finance",
    "copyright": "\u00a9 2026 Kutluhan G\u00fcl",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.googleusercontent.apps.648156139284-j203dop1rb5sqb2d5gevr14frn1c5bn0"
        ]
      }
    }
  }
}
