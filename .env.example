# SubSense — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# Firebase Configuration (get from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ⚠️  GEMINI API KEY — DO NOT add here. It is stored server-side in Firebase Functions config.
# Set it once on the server via:
#   firebase functions:config:set gemini.key="AIza..."
# Then deploy functions: firebase deploy --only functions
# This ensures the key is NEVER exposed in the frontend bundle.
