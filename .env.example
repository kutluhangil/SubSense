# Aboneyim — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ── Frontend (Vite build args) ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Self-Hosted Backend Container (aboneyim_api on macmini-server) ──────────
# Note: None of the variables below start with VITE_, so they are NEVER
# bundled into the browser frontend — they are passed only to aboneyim_api.
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Aboneyim <onboarding@resend.dev>"
ADMIN_EMAILS=
APP_URL="https://macmini-server.taild883a6.ts.net"
